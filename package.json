{
  "name": "shunshou-campus-delivery",
  "version": "1.0.0",
  "private": true,
  "description": "顺手捎 · 校园快递代取：Vite + React 前端，NestJS 后端，PostgreSQL 数据库",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nest start --watch",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "nest build",
    "start": "cross-env TS_NODE_PROJECT=tsconfig.node.json node -r tsconfig-paths/register dist/server/main.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "type:check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
