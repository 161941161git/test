# =====================================================================
# 环境变量模板：复制成 .env 使用；部署时在 Railway / Render 面板里逐条填
# 本文件只有说明，不含任何真实密码
# =====================================================================

# ===== 后端（server）=====
# 数据库连接串。Railway 里用 ${{Postgres.DATABASE_URL}} 引用自动生成，
# 形如 postgresql://postgres:xxxx@roundhouse.proxy.rlwy.net:1234/railway
DATABASE_URL=
# 一般不用填：Railway 内网库自动不加 SSL，Render 托管库自动加 SSL。
# 需要强制时可填 true（强制开）或 false（强制关）
DATABASE_SSL=
# 连接池上限，免费实例 5 足够
DATABASE_POOL_MAX=5
# 后端端口。Railway / Render 会自动注入 PORT，本地留 3000
PORT=3000
# 部署后填你的公网域名，例如 https://shunshou-production.up.railway.app
# 用于把上传图片的地址拼成完整 URL；不填会自动用请求头里的域名兜底
PUBLIC_BASE_URL=

# ===== 前端（client）=====
# 前后端同一个服务部署时留空即可（请求当前域名）；
# 只有前后端分开部署才需要填后端地址，例如 https://shunshou-api.up.railway.app
# 注意：这是构建期变量，改完必须重新部署才生效
VITE_API_BASE_URL=

# ===== 初始化开发者账户 =====
# 首次建表后自动创建的后台账号，登录入口 /admin/login
SEED_ADMIN_USERNAME=xushenxin050831
# 后台密码，自己设置；留空则不会创建管理员
SEED_ADMIN_PASSWORD=
